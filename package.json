{
  "name": "rewindry",
  "version": "0.1.5",
  "description": "Local, immutable checkpoints for visual history of code changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-thepoe/rewindry.git"
  },
  "bugs": {
    "url": "https://github.com/its-thepoe/rewindry/issues"
  },
  "keywords": [
    "local-first",
    "code-history",
    "visual-history",
    "vite",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "rewindry": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-assets.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node --import tsx --test tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.6"
  }
}
